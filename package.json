{
  "name": "qhaze-tech-university",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-university.mjs && node scripts/e2e-curriculum.mjs && node scripts/e2e-learning.mjs && node scripts/e2e-packages.mjs && node scripts/e2e-modules.mjs",
    "verify:code": "vitest run --config tools/code-verification/vitest.config.ts",
    "audit:content": "vitest run --config tools/content-audit/vitest.config.ts",
    "docs:curriculum": "vitest run --config tools/curriculum-docs/vitest.config.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "wasmoon": "1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "5.8",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
